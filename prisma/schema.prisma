// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FloodReport {
  id                String               @id @default(cuid())
  title             String
  description       String
  category          String
  severity          String
  status            String               @default("Needs More Confirmation")
  verificationStatus String              @default("unreviewed")
  locationName      String
  latitude          Float
  longitude         Float
  locationSource    String               @default("manual")
  gpsAccuracyMeters Float?
  imageUrl          String?
  photoCapturedAt   DateTime?
  ownerSessionHash  String?
  reportedByName    String?
  sourceType        String               @default("Community")
  confirmationCount Int                  @default(0)
  resolvedCount     Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  lastActivityAt    DateTime             @default(now())
  resolvedAt        DateTime?
  archivedAt        DateTime?
  incidentId        String
  incident          Incident             @relation(fields: [incidentId], references: [id])
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  confirmations     ReportConfirmation[]
  updates           ReportUpdate[]

  @@index([ownerSessionHash])
  @@index([status, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([severity, createdAt])
  @@index([category, createdAt])
  @@index([sourceType, createdAt])
  @@index([lastActivityAt])
  @@index([latitude, longitude])
  @@index([locationSource])
  @@index([incidentId])
  @@index([userId])
}

model Incident {
  id                      String        @id @default(cuid())
  status                  String        @default("Needs More Confirmation")
  representativeLatitude  Float
  representativeLongitude Float
  locationName            String
  severity                String
  reportCount             Int           @default(1)
  firstReportAt           DateTime      @default(now())
  lastActivityAt          DateTime      @default(now())
  resolvedAt              DateTime?
  archivedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  reports                 FloodReport[]

  @@index([status, lastActivityAt])
  @@index([representativeLatitude, representativeLongitude])
}

model ReportConfirmation {
  id               String      @id @default(cuid())
  reportId         String
  confirmationType String
  ipHash           String?
  createdAt        DateTime    @default(now())
  report           FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, confirmationType, ipHash])
  @@index([reportId])
  @@index([reportId, confirmationType, createdAt])
}

model ReportUpdate {
  id         String      @id @default(cuid())
  reportId   String
  updateType String
  message    String
  imageUrl   String?
  severity   String?
  status     String?
  createdAt  DateTime    @default(now())
  report     FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model EvacuationCenter {
  id            String   @id @default(cuid())
  name          String
  description   String?
  address       String
  city          String
  province      String
  latitude      Float
  longitude     Float
  contactNumber String?
  facilities    String[]
  status        String   @default("Unknown")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SafetyTip {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmergencyContact {
  id            String   @id @default(cuid())
  agencyName    String
  contactNumber String
  region        String?
  province      String?
  city          String?
  description   String?
  isNational    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutContent {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String
  content    String
  updatedAt  DateTime @updatedAt
}

model RequestRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  displayName  String?
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  reports      FloodReport[]
  adminAuditLogs AdminAuditLog[]

  @@index([role])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
