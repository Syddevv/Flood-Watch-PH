// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FloodReport {
  id                  String               @id @default(cuid())
  title               String
  description         String
  category            String
  severity            String
  status              String               @default("Needs More Confirmation")
  verificationStatus  String               @default("unreviewed")
  reviewVersion       Int                  @default(1)
  reviewedAt          DateTime?
  reviewedByUserId    String?
  reviewPublicMessage String?
  locationName        String
  latitude            Float
  longitude           Float
  scopeVersion        String               @default("osm-1504656-2026-10-14")
  locationSource      String               @default("manual")
  gpsAccuracyMeters   Float?
  gpsLatitude         Float?
  gpsLongitude        Float?
  gpsCapturedAt       DateTime?
  imageUrl            String?
  photoCapturedAt     DateTime?
  onsitePolicyVersion String?
  onsiteEligibleAt    DateTime?
  ownerSessionHash    String?
  reportedByName      String?
  sourceType          String               @default("Community")
  confirmationCount   Int                  @default(0)
  resolvedCount       Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastActivityAt      DateTime             @default(now())
  resolvedAt          DateTime?
  archivedAt          DateTime?
  incidentId          String
  incident            Incident             @relation(fields: [incidentId], references: [id])
  userId              String?
  user                User?                @relation(fields: [userId], references: [id])
  reviewer            User?                @relation("FloodReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  confirmations       ReportConfirmation[]
  updates             ReportUpdate[]
  rescueRequests      RescueRequest[]

  @@index([ownerSessionHash])
  @@index([status, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([severity, createdAt])
  @@index([category, createdAt])
  @@index([sourceType, createdAt])
  @@index([lastActivityAt])
  @@index([latitude, longitude])
  @@index([locationSource])
  @@index([onsitePolicyVersion])
  @@index([incidentId])
  @@index([userId])
}

model Incident {
  id                      String        @id @default(cuid())
  status                  String        @default("Needs More Confirmation")
  representativeLatitude  Float
  representativeLongitude Float
  locationName            String
  severity                String
  reportCount             Int           @default(1)
  firstReportAt           DateTime      @default(now())
  lastActivityAt          DateTime      @default(now())
  resolvedAt              DateTime?
  archivedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  reports                 FloodReport[]

  @@index([status, lastActivityAt])
  @@index([representativeLatitude, representativeLongitude])
}

model ReportConfirmation {
  id               String      @id @default(cuid())
  reportId         String
  confirmationType String
  ipHash           String?
  createdAt        DateTime    @default(now())
  report           FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, confirmationType, ipHash])
  @@index([reportId])
  @@index([reportId, confirmationType, createdAt])
}

model ReportUpdate {
  id         String      @id @default(cuid())
  reportId   String
  updateType String
  message    String
  imageUrl   String?
  severity   String?
  status     String?
  createdAt  DateTime    @default(now())
  report     FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model EvacuationCenter {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  address            String
  city               String
    localityCode       String?
  province           String
  latitude           Float?
  longitude          Float?
  externalKey        String?   @unique
  sourceSnapshot     Json?
  sourceCheckedAt    DateTime?
  facilityType       String?
  permanent          Boolean?
  capacityFamilies   Int?
  lastDocumentedEventDate DateTime?
  currentOccupancy   Int?
  currentCapacity    Int?
  adminEvidenceUrl   String?
  duplicateReviewNotes String?
  scopeVersion       String    @default("osm-1504656-2026-10-14")
  contactNumber      String?
  facilities         String[]
  status             String    @default("needs_verification")
  barangay           String?
  region             String?
  verificationStatus String    @default("needs_verification")
  sourceType         String    @default("community_reference")
  sourceName         String?
  sourceUrl          String?
  lastVerifiedAt     DateTime?
  availabilityConfirmedAt DateTime?
  notes                   String?
  estimatedCapacity       Int?
  isArchived              Boolean   @default(false)
  archivedAt              DateTime?
  archivedByUserId        String?
  updatedByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([status])
  @@index([verificationStatus])
  @@index([isArchived])
  @@index([city, province])
    @@index([localityCode])
  @@index([updatedAt])
}

model SafetyTip {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmergencyContact {
  id            String   @id @default(cuid())
  agencyName    String
  contactNumber String
  sourceKey     String?  @unique
  sourceSnapshot Json?
  phones        Json?
  sourceFreshness String?
  preferred     Boolean @default(false)
  updatedByUserId String?
  adminEvidenceUrl String?
  notes         String?
  duplicateReviewNotes String?
  sourceUrl     String?
  lastSourceCheckedAt DateTime?
  verificationStatus String @default("needs_verification")
  isArchived    Boolean @default(false)
  category      String   @default("Local Response")
  region        String?
  province      String?
  city          String?
  description   String?
  isNational    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([verificationStatus, isArchived])
  @@index([province, city])
}

model AboutContent {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String
  content    String
  updatedAt  DateTime @updatedAt
}

model RequestRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  passwordHash            String
  displayName             String?
  role                    String               @default("user")
  emailVerificationStatus String               @default("pending")
  emailVerifiedAt         DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  sessions                Session[]
  reports                 FloodReport[]
  reviewedFloodReports    FloodReport[]        @relation("FloodReportReviewer")
  adminAuditLogs          AdminAuditLog[]
  emailVerification       EmailVerification?
  createdRescueRequests   RescueRequest[]      @relation("RescueCreator")
  requestedRescueRequests RescueRequest[]      @relation("RescueRequester")
  ownedRescueRequests     RescueRequest[]      @relation("RescueCaseOwner")
  rescueEvents            RescueRequestEvent[] @relation("RescueEventActor")
  recordedRescueAssignments RescueAssignment[] @relation("RescueAssignmentRecorder")
  confirmedRescueDispatches RescueAssignment[] @relation("RescueDispatchConfirmer")

  @@index([role])
  @@index([emailVerificationStatus])
}

model RescueRequest {
  id                             String               @id @default(cuid())
  reference                      String               @unique
  requesterUserId                String?
  creatorUserId                  String
  intakeChannel                  String
  assistedIntakeMethod           String?
  idempotencyKey                 String
  idempotencyHash                String
  forWhom                        String
  assistedPersonName             String?
  relationship                   String?
  primaryContact                 String
  alternateContact               String?
  peopleCount                    Int
  vulnerabilityTags              String[]             @default([])
  vulnerabilityNotes             String?
  description                    String
  locationName                   String
  latitude                       Float?
  longitude                      Float?
  locationUncertainty            String
  localityCode                   String
  barangay                       String
  linkedReportId                 String?
  linkedReportConsentConfirmedAt DateTime?
  priority                       String               @default("routine")
  status                         String               @default("received")
  caseOwnerUserId                String?
  confirmedTeamReference         String?
  outcome                        String?
  version                        Int                  @default(1)
  workflowVersion                Int                  @default(1)
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  requester                      User?                @relation("RescueRequester", fields: [requesterUserId], references: [id])
  creator                        User                 @relation("RescueCreator", fields: [creatorUserId], references: [id])
  caseOwner                      User?                @relation("RescueCaseOwner", fields: [caseOwnerUserId], references: [id])
  linkedReport                   FloodReport?         @relation(fields: [linkedReportId], references: [id])
  events                         RescueRequestEvent[]
  assignments                    RescueAssignment[]

  @@unique([creatorUserId, intakeChannel, idempotencyKey])
  @@index([requesterUserId, createdAt, id])
  @@index([status, priority, updatedAt])
  @@index([localityCode, status])
  @@index([caseOwnerUserId, status])
  @@index([primaryContact, createdAt])
}

model RescueRequestEvent {
  id                      String        @id @default(cuid())
  requestId               String
  actorUserId             String?
  assignmentId            String?
  actionKey               String?
  actionHash              String?
  source                  String?
  details                 Json?
  occurredAt              DateTime?
  eventType               String
  previousStatus          String?
  nextStatus              String?
  previousPriority        String?
  nextPriority            String?
  previousCaseOwnerUserId String?
  nextCaseOwnerUserId     String?
  visibility              String
  reason                  String?
  note                    String?
  createdAt               DateTime      @default(now())
  request                 RescueRequest @relation(fields: [requestId], references: [id])
  actor                   User?         @relation("RescueEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  assignment              RescueAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id])
  @@index([assignmentId, createdAt])
  @@unique([requestId, actionKey])
}

model ResponderOrganization {
  id                    String             @id @default(cuid())
  name                  String
  type                  String
  homeLocalityCode      String
  coverageLocalityCodes String[]           @default([])
  capabilityCodes       String[]           @default([])
  contactOffice         String?
  contactPerson         String?
  officialPhone         String?
  secondaryContact      String?
  preferredChannel      String?
  availability          String             @default("unknown")
  active                Boolean            @default(true)
  lastContactVerifiedAt DateTime?
  demo                  Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assignments           RescueAssignment[]

  @@index([name])
  @@index([homeLocalityCode, active])
  @@index([availability, active])
}

model RescueAssignment {
  id                         String                 @id @default(cuid())
  requestId                  String
  organizationId             String
  recordedByAdminUserId      String
  status                     String                 @default("selected")
  selectedAt                 DateTime               @default(now())
  contactChannel             String?
  contactOutcome             String?
  contactDetails             String?
  contactedAt                DateTime?
  acknowledgementOutcome     String?
  acknowledgedAt             DateTime?
  dispatchConfirmedAt        DateTime?
  dispatchConfirmedByAdminId String?
  dispatchMethod             String?
  departedAt                 DateTime?
  arrivedAt                  DateTime?
  reportedCompletedAt        DateTime?
  resolutionDetails          String?
  endedAt                    DateTime?
  endReason                  String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  request                    RescueRequest          @relation(fields: [requestId], references: [id])
  organization               ResponderOrganization  @relation(fields: [organizationId], references: [id])
  recordedByAdmin            User                   @relation("RescueAssignmentRecorder", fields: [recordedByAdminUserId], references: [id])
  dispatchConfirmedByAdmin   User?                  @relation("RescueDispatchConfirmer", fields: [dispatchConfirmedByAdminId], references: [id], onDelete: Restrict)
  events                     RescueRequestEvent[]

  @@index([requestId, selectedAt, id])
  @@index([organizationId, status])
  @@index([status, selectedAt])
}

model EmailVerification {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  codeHash                String
  keyId                   String
  expiresAt               DateTime
  attemptCount            Int       @default(0)
  resendAvailableAt       DateTime
  consumedAt              DateTime?
  version                 Int       @default(1)
  providerMessageId       String?
  deliveryStatus          String    @default("pending")
  lastDeliveryAttemptAt   DateTime?
  lastDeliverySucceededAt DateTime?
  lastDeliveryErrorCode   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([consumedAt])
  @@index([providerMessageId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AdminOperationalAction {
  id            String   @id @default(cuid())
  targetType    String
  targetId      String
  actionType    String
  previousValue String?
  nextValue     String?
  visibility    String   @default("internal")
  note          String?
  actorUserId   String?
  requestId     String?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actionType, createdAt])
}

model AdminNotification {
  id              String    @id @default(cuid())
  type            String
  title           String
  detail          String
  targetType      String?
  targetId        String?
  priority        String    @default("normal")
  recipientUserId String?
  dedupeKey       String?
  readAt          DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId, readAt, createdAt])
  @@index([priority, createdAt])
  @@index([targetType, targetId])
}

model AdminSetting {
  key             String   @id
  value           String
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
